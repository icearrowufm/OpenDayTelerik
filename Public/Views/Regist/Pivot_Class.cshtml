

@{
    ViewBag.Title = "Pivot_Class";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<script src="//cdnjs.cloudflare.com/ajax/libs/jszip/2.4.0/jszip.min.js"></script>


@(Html.Kendo().Grid<OpenDayTelerik.Models.View_Pivot_Class>()
    .Name("grid") // Tên của grid
    .Columns(columns =>
    {
        columns.Bound(p => p.ID).Title("Class ID");
        columns.Bound(p => p.CLASSNAME).Title("Class Name");
        columns.Bound(p => p.GROUPCLASS).Title("Khung giờ");
        columns.Bound(p => p.TIMESTART).Title("Thời gian bắt đầu");
        columns.Bound(p => p.TIMEEND).Title("Thời gian kết thúc");
        columns.Bound(p => p.TYPE).Title("Nhóm");
        columns.Bound(p => p.ROOM).Title("Phòng");
        columns.Bound(p => p.PAX).Title("Số lượng");
        columns.Bound(p => p.PAXREG).Title("Số lượng đăng ký");
        columns.Bound(p => p.PAXCHECKIN).Title("Số lượng tham dự");
@* columns.Template(@<text>  @Html.ActionLink("DS Đăng ký", "List_Regist_Class", "Regist", new { id = "#= ID #" }, new { @class = "btn btn-primary" }) </text>).Title("Actions");
    columns.Template(@<text>  @Html.ActionLink("DS Tham dự", "List_Checkin_Class", "Regist", new { id = item.ID }, new { @class = "btn btn-primary" }) </text>).Title("Actions");
      columns.Template(@<text>  @Html.ActionLink("Điểm danh lớp học", "Checkin_Class", "Regist", new { id = item.ID }, new { @class = "btn btn-primary" }) </text>).Title("Actions");*@
})

.Groupable()
.Sortable() // Thêm chức năng sắp xếp
.ToolBar(toolbar =>
{
toolbar.Excel();
})
.Excel(excel => excel
.FileName("Pivot_Class_Export.xlsx") // Tên file xuất
.Filterable(true) // Cho phép lọc
.ProxyURL(Url.Action("Excel_Export_Save", "Regist")) // Đường dẫn tới action xử lý lưu file
)
.DataSource(dataSource => dataSource
.Ajax()
.Read(read => read.Action("GetData_Pivot_Class", "Regist")) // Action trả về dữ liệu cho grid
)

)

<script>
    // Hàm làm mới dữ liệu trong Kendo Grid
    function refreshGrid() {
        var grid = $("#grid").data("kendoGrid"); // Lấy instance của grid
        if (grid) {
            grid.dataSource.read(); // Tải lại dữ liệu
            grid.refresh(); // Làm mới giao diện của grid
        }
    }

    // Gọi hàm refreshGrid mỗi 30 giây (30000 milliseconds)
    setInterval(refreshGrid, 30000);
</script>
