@{
    ViewBag.Title = "Lỗi";
    Layout = null;
}
    <html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>Chuyển tiếp</title>
        <script src="https://cdn.tailwindcss.com"></script>
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400..800;1,400..800&display=swap"
              rel="stylesheet" />
        <script src="~/Scripts/Countdown.js"></script>
        <link rel="stylesheet" href="~/Content/index.css" />
        <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.js"></script>
        <script src="https://code.jquery.com/jquery-3.7.1.min.js"
                integrity="sha256-/JqT3SQfawRcv/BIHPThkBvs0OEvtFFmqPF/lYI/Cxo="
                crossorigin="anonymous"></script>
        <script>
        tailwind.config = {
            content: ["./**/*.html"],
            theme: {
                extend: {
                    colors: {
                        neutral: "#E1E1DE",
                        highlight: "#CEECF5",
                        secondary: "#FBAD22",
                        primary: "#242B68",
                        darkneutral: "#61646B",
                    },
                    gridTemplateRows: {
                        15: "repeat(15, minmax(0, 1fr))",
                        14: "repeat(14, minmax(0, 1fr))",
                    },
                    gridRow: {
                        "span-11": "span 11 / span 11",
                        "span-14": "span 14 / span 14",
                    },
                    fontFamily: {
                        Halyard: ["Halyard", "EB Garamond", "serif"],
                    },
                },
            },
        };
        </script>
        <style>
            #countdown {
                font-size: 24px;
                font-weight: bold;
                color: #333;
            }
        </style>
    </head>
    <body>
        <div class="px-3">
            <div class="h-18 w-full" style="padding-top:10px; padding-bottom:10px">
                <img src="~/Content/Image/logo.png" width="150" alt="Fulbright's Open Day" />
            </div>
            <div class="w-full h-25 mb-4 border border-black rounded-md bg-container" style="background-color:#001a6e">
                <center> <img src="~/Content/Image/bg.png" width="640" height="150" alt="Fulbright's Open Day" /></center>
            </div>
            <!-- paragraph -->
            <article class="flex flex-col justify-center items-center mb-6">
                <h1 class="text-2xl font-bold text-center mb-3 text-primary font-garamond">
                    Đã xảy ra sự cố
                </h1>
                <p>Rất tiếc, có lỗi xảy ra trong quá trình xử lý yêu cầu của bạn.</p>
                <a href="/Home/RequestPage"
            </article>
        </div>

    </body>
    </html>

